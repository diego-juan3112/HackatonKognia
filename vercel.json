{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "services": {
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "src.api.app_voice:app",
      "functions": {
        "src/api/app_voice.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,docs/**,web/**,migrations/**,infra/**,scripts/**,spikes/**,.venv*/**,.claude/**,**/__pycache__/**,.env,.env.*}"
        }
      }
    },
    "web": {
      "root": "web",
      "framework": "astro",
      "buildCommand": "PUBLIC_API_URL=${PUBLIC_API_URL:-/api} npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
