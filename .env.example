# =========================================================
# Copia este archivo a .env y completa los valores.
# NUNCA subas el .env real a git (ya está en .gitignore).
# =========================================================

# ---- Proveedor de modelo activo: "azure" o "openai" ----
# Usa "openai" para desarrollar HOY sin depender de que ya
# exista el recurso de Azure. El día del hackathon solo
# cambias MODEL_PROVIDER=azure y las 4 variables de abajo,
# el resto del código no se toca (por eso existe el "puerto"
# LLMProvider en infrastructure/).
MODEL_PROVIDER=openai

# ---- Azure OpenAI / Azure AI Foundry ----
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- OpenAI directo (para probar hoy mismo) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Herramientas opcionales ----
TAVILY_API_KEY=

# ---- Servidor ----
APP_ENV=local
LOG_LEVEL=INFO
