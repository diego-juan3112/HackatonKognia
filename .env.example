# =========================================================
# Copia este archivo a .env y completa los valores.
# NUNCA subas el .env real a git (esta en .gitignore).
# En Vercel se definen como variables del proyecto (docs/11 seccion 2).
# =========================================================

# ---- Motores de voz y analista (obligatorias) ----
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Sesion anonima firmada (obligatoria) ----
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SIGNING_KEY=

# ---- datos.gov.co (recomendada; si es invalido se descarta y se sigue anonimo) ----
DATOS_GOV_APP_TOKEN=

# ---- Voz clonada con Cartesia (opcional: sin ella se usa la voz del motor) ----
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ---- CORS: solo si la web y la API estan en dominios distintos ----
ALLOWED_ORIGINS=http://localhost:4321

# ---- Latencia y deteccion de voz (medir con scripts/bench_models.py antes de cambiar) ----
# VOICE_OPENAI_MODEL=gpt-realtime-2.1        # o gpt-realtime
# REALTIME_TURN_DETECTION=server_vad         # o semantic_vad
# REALTIME_SILENCE_DURATION_MS=500           # 300 responde antes pero puede cortar pausas
# REALTIME_VAD_THRESHOLD=0.65
# REALTIME_INTERRUPT_RESPONSE=false          # el navegador interrumpe tras >= 1 s de voz
# REALTIME_NOISE_REDUCTION=near_field        # near_field | far_field | vacio

# ---- Trazas (opcional; las lee la libreria) ----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ---- Servidor ----
APP_ENV=local
LOG_LEVEL=INFO
