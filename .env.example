# =========================================================
# Copia este archivo a .env y completa los valores.
# NUNCA subas el .env real a git (ya está en .gitignore).
# =========================================================

# ---- Proveedor de modelo: "fake" | "openai" | "azure" ----
# "fake" corre el grafo completo sin red ni credenciales: util para
# desarrollar, para los tests y para demos offline.
# El dia del reto se cambia a "azure" (o "openai") y se llenan las
# variables de abajo; no se toca una linea de codigo, porque el unico
# archivo que conoce el proveedor es integrations/llm/factory.py.
MODEL_PROVIDER=fake

# ---- Azure OpenAI / Azure AI Foundry ----
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- OpenAI directo (para probar hoy mismo) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Herramientas opcionales ----
TAVILY_API_KEY=

# ---- Servidor ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- Dominio y base de conocimiento (agregado en 0.2.0) ----
# Ruta al YAML que describe el dominio. El dia del reto: apunta al nuevo.
DOMAIN_CONFIG_PATH=config/domains/faq_demo.yaml

# "fake" = embeddings lexicos deterministas, sin red ni API key.
# "openai" = embeddings reales (requiere OPENAI_API_KEY).
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=.chroma
CHROMA_COLLECTION=kognia
RETRIEVAL_TOP_K=4
