# =========================================================
# Copia este archivo a .env y completa los valores.
# NUNCA subas el .env real a git (ya esta en .gitignore).
# =========================================================

# ---- Proveedor de modelo: "fake" | "nvidia" | "azure" | "openai" ----
# "fake"   corre el grafo completo sin red ni credenciales. Es lo que usan
#          los tests y la demo offline.
# "nvidia" es el proveedor real. API key gratuita en https://build.nvidia.com
# "azure"/"openai" se conservan SOLO como respaldo de pago por si el tier
#          gratuito de NVIDIA se agota a mitad de la demo.
# El unico archivo que conoce el proveedor es integrations/llm/factory.py.
MODEL_PROVIDER=fake

# ---- NVIDIA NIM (proveedor real) ----
# gpt-oss-20b se eligio midiendo, no por fama (2026-09-23):
#   nemotron-3-super-120b-a12b -> 1.1s pero 3 de 6 llamadas dieron 503
#   gpt-oss-20b                -> 0 fallos, JSON y espanol correctos
# A pesar del nombre es un modelo de pesos abiertos servido por NVIDIA:
# no hay cuenta de OpenAI ni pago de por medio.
#
# Si vas a cambiarlo, NO confies en el catalogo de la libreria: lista modelos
# que ya estan en end-of-life y devuelven 410. Preguntale a la API:
#   curl -H "Authorization: Bearer $NVIDIA_API_KEY" \
#        https://integrate.api.nvidia.com/v1/models
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# gpt-oss razona antes de responder y eso domina la latencia. Medido sobre
# 5 llamadas iguales:  sin el parametro -> 19.4s y 100 tokens de salida
#                      effort=low       ->  3.3s y  27 tokens
# Misma calidad de respuesta para tareas tan simples. Sube a medium/high solo
# si el dominio real lo necesita.
NVIDIA_REASONING_EFFORT=low

# ---- Azure OpenAI (respaldo) ----
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- OpenAI directo (respaldo) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Base de datos ----
# Apunta al contenedor de docker-compose en el 5433, NO a un PostgreSQL
# nativo en el 5432. Levantalo con: docker compose up -d
DATABASE_URL=postgresql://kognia:kognia_local_dev@localhost:5433/kognia
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Estas tres las lee docker-compose.yml, no la aplicacion.
POSTGRES_USER=kognia
POSTGRES_PASSWORD=kognia_local_dev
POSTGRES_DB=kognia
POSTGRES_PORT=5433

# ---- Dominio ----
# Ruta al YAML que describe el dominio. El dia del reto: apunta al nuevo.
DOMAIN_CONFIG_PATH=config/domains/faq_demo.yaml

# ---- Base de conocimiento (RAG) ----
# "fake"  = vectores lexicos deterministas, sin red ni descarga. Para tests.
# "local" = intfloat/multilingual-e5-base corriendo en esta maquina.
#           Descarga ~1.1 GB la primera vez y lo cachea.
# OJO: la columna document_chunks.embedding es vector(768). Cambiar a un
# modelo de otra dimension exige una migracion nueva y reindexar.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RETRIEVAL_TOP_K=4

# ---- Sesiones ----
# Identificacion por cedula SIN contrasena: esto no es autenticacion real.
SESSION_TTL_HOURS=12

# ---- Servidor ----
APP_ENV=local
LOG_LEVEL=INFO
