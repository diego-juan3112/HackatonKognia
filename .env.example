# =========================================================
# Copia este archivo a .env y completa los valores.
# NUNCA subas el .env real a git (ya esta en .gitignore).
# =========================================================

# ---- LLM: Gemini (Google AI Studio) ----
# Key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Elegido midiendo (ver src/config.py): ~1 s por llamada, 15/15 correctas.
# Si lo cambias, NO confies en la lista de modelos: los gemini-2.5-* aparecen
# listados y responden 404 para keys nuevas. Pruebalo antes de elegirlo.
GEMINI_MODEL=gemini-3.5-flash-lite

# Control de "pensamiento" de Gemini 3+. Cambialo JUNTO con el modelo:
# gemini-3.8-flash, por ejemplo, rechaza "minimal" con un 400.
GEMINI_THINKING_LEVEL=minimal

# ---- Base de datos de desarrollo ----
# Apunta al contenedor de docker-compose en el 5433, NO a un PostgreSQL
# nativo en el 5432. Levantalo con: docker compose up -d
DATABASE_URL=postgresql://kognia:kognia_local_dev@localhost:5433/kognia

# ---- Base de datos de pruebas ----
# Los tests de integracion corren AQUI, nunca en DATABASE_URL. Se crea y migra
# sola. El nombre DEBE terminar en _test: los tests se niegan a vaciar otra.
TEST_DATABASE_URL=postgresql://kognia:kognia_local_dev@localhost:5433/kognia_test

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Estas cuatro las lee docker-compose.yml, no la aplicacion. Solo se aplican
# la PRIMERA vez que se crea el volumen: cambiarlas despues no cambia la base.
POSTGRES_USER=kognia
POSTGRES_PASSWORD=kognia_local_dev
POSTGRES_DB=kognia
POSTGRES_PORT=5433

# ---- Dominio ----
# Ruta al YAML que describe el dominio. El dia del reto: apunta al nuevo.
DOMAIN_CONFIG_PATH=config/domains/faq_demo.yaml

# ---- Base de conocimiento (RAG) ----
# Corre local en CPU, sin API key. Descarga ~1.1 GB la primera vez y luego
# carga desde la cache sin tocar la red.
# OJO: la columna document_chunks.embedding es vector(768). Cambiar a un
# modelo de otra dimension exige una migracion nueva y reindexar.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RETRIEVAL_TOP_K=4

# ---- Sesiones ----
# Identificacion por cedula SIN contrasena: esto no es autenticacion real.
SESSION_TTL_HOURS=12

# ---- Servidor ----
APP_ENV=local
LOG_LEVEL=INFO
