---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Mic from "@lucide/astro/icons/mic";
import Base from "../layouts/Base.astro";
import Orb from "../components/Orb.astro";
import brief from "../../mocks/brief.json";

const nf = new Intl.NumberFormat("es-CO");
/** Total installed beds in the source (REPS, corte 5-nov-2022). The brief does not carry it yet. */
const BEDS = 97036;

const figures = [
  { key: "providers", value: nf.format(brief.stats.providers), label: "IPS" },
  { key: "site_codes", value: nf.format(brief.stats.site_codes), label: "sedes" },
  { key: "beds", value: nf.format(BEDS), label: "camas" },
];
---

<Base title="IPS en Vivo · Consulta el registro de IPS de Colombia" description="Consulta por voz el registro de IPS de Colombia (REPS, MinSalud) en datos.gov.co.">
  <div class="cover">
    <section class="hero">
      <div class="hero-copy">
        <h1>Consulta el registro de IPS de Colombia</h1>
        <p class="lede">Pregunta con tu voz cuántas hay, dónde están y con qué capacidad cuentan.</p>
        <p class="ai-badge" data-testid="ai-badge">Asistente de IA: puede equivocarse; las cifras salen de datos.gov.co.</p>
        <a class="btn btn-talk" href="/consola?iniciar=1">
          <Mic aria-hidden="true" />
          Hablar ahora
        </a>
      </div>
      <div class="hero-orb">
        <Orb />
      </div>
    </section>

    <section class="source" aria-labelledby="source-title">
      <h2 id="source-title" class="sr-only">La fuente en cifras</h2>
      <dl class="figures">
        {
          figures.map((f) => (
            <div>
              <dd class="num" data-brief={f.key}>{f.value}</dd>
              <dt>{f.label}</dt>
            </div>
          ))
        }
      </dl>
      <p class="origin">REPS · MinSalud, corte nov-2022</p>
    </section>

    <section class="ask" aria-labelledby="ask-title">
      <h2 id="ask-title">Empieza por una pregunta</h2>
      <ul class="questions">
        {
          brief.suggested_questions.map((q) => (
            <li>
              <a href={`/consola?q=${encodeURIComponent(q)}`}>
                <span>{q}</span>
                <ArrowRight aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<script>
  import { fetchBrief, USING_MOCKS } from "../voice/api";

  const nf = new Intl.NumberFormat("es-CO");

  // With a backend, replace the recorded figures with the live brief (docs/09 §8).
  document.addEventListener("astro:page-load", async () => {
    if (USING_MOCKS || !document.querySelector("[data-brief]")) return;
    const { brief, live } = await fetchBrief();
    if (!live) return;
    for (const key of ["providers", "site_codes"] as const) {
      const el = document.querySelector(`[data-brief="${key}"]`);
      if (el) el.textContent = nf.format(brief.stats[key]);
    }
  });
</script>

<style>
  .cover {
    display: grid;
    gap: clamp(var(--s-6), 6vw, var(--s-8));
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(var(--s-5), 6vw, var(--s-8)) var(--gutter) var(--s-7);
  }

  /* ── Hero ──────────────────────────────────────────────────────────────── */

  .hero {
    --orb-size: clamp(220px, 34vw, 440px);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: var(--s-6);
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }

  h1 {
    max-width: 14ch;
    font-size: var(--t-2xl);
    font-weight: 720;
    font-variation-settings: "wdth" 88;
    letter-spacing: -0.03em;
    line-height: 0.98;
    color: var(--primary-ink);
  }

  .lede {
    max-width: 38ch;
    color: var(--ink-2);
    font-size: clamp(var(--t-md), 1rem + 0.6vw, 1.3rem);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .hero .btn-talk {
    min-height: 3.75rem;
    padding-inline: var(--s-6);
    font-size: var(--t-md);
  }

  .hero-orb {
    display: grid;
    place-items: center;
  }

  /* ── Source, in figures ────────────────────────────────────────────────── */

  .source {
    display: grid;
    gap: var(--s-3);
    padding-block: clamp(var(--s-5), 4vw, var(--s-6));
    border-block: 1px solid var(--border);
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .figures div {
    display: grid;
    gap: var(--s-1);
  }

  .figures dd {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 0.6rem + 4.6vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--primary-ink);
  }

  .figures dt {
    color: var(--ink-2);
    font-size: clamp(var(--t-sm), 0.8rem + 0.4vw, var(--t-md));
    font-weight: 600;
  }

  .origin {
    color: var(--ink-3);
    font-size: var(--t-sm);
  }

  /* ── Questions ─────────────────────────────────────────────────────────── */

  .ask {
    display: grid;
    gap: var(--s-4);
  }

  h2 {
    font-size: var(--t-lg);
  }

  .questions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--s-3);
  }

  .questions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: 100%;
    min-height: 3.75rem;
    padding: var(--s-3) var(--s-4) var(--s-3) var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--card);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }

  .questions a :global(svg) {
    color: var(--accent);
    transition: transform 0.2s var(--ease);
  }

  .questions a:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .questions a:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 760px) {
    .hero {
      --orb-size: min(44vw, 170px);
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }

    .hero-orb {
      order: -1;
      justify-items: start;
    }

    .hero .btn-talk {
      width: 100%;
    }
  }
</style>
