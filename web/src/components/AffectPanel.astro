---
/**
 * Affect and style (F-08, F-09; docs/10 §6): per-utterance estimate, valence
 * line, text/voice discrepancy and the style in force with its reason.
 * Everything here is labelled as an estimate (R-26).
 */
---

<section class="affect" id="affect" aria-labelledby="affect-title">
  <header class="pane-head">
    <h2 id="affect-title">Afecto y estilo</h2>
    <p>Estimaciones de cómo suena la persona. No son un diagnóstico y nunca cambian los datos.</p>
  </header>
  <div class="affect-body" id="affect-body" aria-live="polite"></div>
</section>

<script>
  import { bind, byId, esc, icon, panel } from "../scripts/dom";
  import { valence, type AffectEntry, type ConsoleState } from "../voice/store";
  import type { AffectMethod, Sentiment, StyleId } from "../voice/types";

  const METHOD: Record<AffectMethod, string> = {
    text: "estimación del texto",
    voice: "estimación de la voz",
    fused: "estimación combinada (texto y voz)",
  };

  const SENTIMENT: Record<Sentiment, string> = {
    positive: "positivo",
    neutral: "neutral",
    negative: "negativo",
    uncertain: "incierto",
  };

  const STYLE: Record<StyleId, string> = { directo: "Directo", calido: "Cálido", didactico: "Didáctico", neutro: "Neutro" };

  const W = 320;
  const H = 76;
  const PAD_L = 62;
  const PAD_R = 12;
  const Y = { 1: 14, 0: 38, "-1": 62 } as const;
  const yOf = (v: number): number => (v > 0 ? Y[1] : v < 0 ? Y["-1"] : Y[0]);

  /** Valence line: +1, 0, −1 per utterance; an uncertain reading leaves a gap. */
  function line(entries: AffectEntry[]): string {
    const pts = entries.slice(-12).map((e) => valence(e.estimate.sentiment));
    const n = pts.length;
    const x = (i: number): number => (n === 1 ? (PAD_L + W - PAD_R) / 2 : PAD_L + (i * (W - PAD_L - PAD_R)) / (n - 1));
    let d = "";
    let pen = false;
    let dots = "";
    pts.forEach((v, i) => {
      if (v === null) {
        pen = false;
        return;
      }
      d += `${pen ? "L" : "M"}${x(i).toFixed(1)} ${yOf(v)} `;
      pen = true;
      const cls = v > 0 ? "pos" : v < 0 ? "neg" : "neu";
      dots += `<circle class="${cls}" cx="${x(i).toFixed(1)}" cy="${yOf(v)}" r="${i === n - 1 ? 5 : 3.5}"/>`;
    });
    const summary = entries
      .slice(-12)
      .map((e) => SENTIMENT[e.estimate.sentiment])
      .join(", ");
    return `<svg class="valence" viewBox="0 0 ${W} ${H}" role="img" aria-label="Línea de valencia por intervención: ${esc(summary)}">
      <g class="grid">
        <line x1="${PAD_L}" x2="${W - PAD_R}" y1="${Y[1]}" y2="${Y[1]}"/>
        <line x1="${PAD_L}" x2="${W - PAD_R}" y1="${Y[0]}" y2="${Y[0]}"/>
        <line x1="${PAD_L}" x2="${W - PAD_R}" y1="${Y["-1"]}" y2="${Y["-1"]}"/>
        <text x="0" y="${Y[1] + 4}">positivo</text>
        <text x="0" y="${Y[0] + 4}">neutral</text>
        <text x="0" y="${Y["-1"] + 4}">negativo</text>
      </g>
      <path d="${d}"/>
      ${dots}
    </svg>`;
  }

  function current(e: AffectEntry, s: ConsoleState): string {
    const est = e.estimate;
    const turn = s.turns.find((t) => t.turn_id === est.turn_id);
    const cues = est.cues.map((c) => `<li>${esc(c)}</li>`).join("");
    const split =
      est.discrepancy && e.channels?.text && e.channels.voice
        ? `<div class="split">
            <p class="tag tag-warn">${icon("split")} texto y voz no coinciden</p>
            <dl>
              <dt>Por el texto</dt><dd>${esc(e.channels.text.emotion)}, ${SENTIMENT[e.channels.text.sentiment]}</dd>
              <dt>Por la voz</dt><dd>${esc(e.channels.voice.emotion)}, ${SENTIMENT[e.channels.voice.sentiment]}</dd>
            </dl>
          </div>`
        : "";
    return `<div class="reading sent-${est.sentiment}">
      <p class="about">Intervención${turn ? ` del turno ${turn.n}` : ""}: «${esc(e.text)}»</p>
      <p class="emotion">${esc(est.emotion)}</p>
      <dl class="facts">
        <dt>Sentimiento</dt><dd>${SENTIMENT[est.sentiment]}</dd>
        <dt>Estado</dt><dd>${esc(est.state_hint)}</dd>
        <dt>Método</dt><dd>${METHOD[est.method]}</dd>
      </dl>
      ${split}
      ${cues ? `<ul class="cues" aria-label="Señales observadas">${cues}</ul>` : ""}
    </div>`;
  }

  function style(s: ConsoleState): string {
    const st = s.style;
    const origin = st.source === "preference" ? "preferencia explícita" : st.style === "neutro" ? "por defecto" : "inferido";
    const signal = s.styleSignal
      ? `<p class="signal">${s.styleSignal.count} de ${s.styleSignal.needed} señales seguidas de ${esc(s.styleSignal.hint)}: el estilo todavía no cambia.</p>`
      : "";
    return `<div class="style style-${st.style}">
      <p class="style-name"><span>Estilo vigente</span> <strong>${STYLE[st.style]}</strong> <span class="tag ${st.source === "preference" ? "tag-warn" : "tag-quiet"}">${origin}</span></p>
      <p class="why">${esc(st.reason)} Aplica desde el turno ${st.applies_from_turn}.</p>
      ${signal}
    </div>`;
  }

  panel("affect", () => {
    const body = byId("affect-body");
    return bind(["affect", "style", "meta"], (s) => {
      if (!body) return;
      const last = s.affect[s.affect.length - 1];
      const reading = last
        ? current(last, s) + line(s.affect)
        : `<p class="affect-empty">Cuando hables, aquí aparece una estimación por intervención${s.voiceAnalysis ? ", a partir del texto y de la voz" : ", a partir del texto. Con tu permiso también se estima el tono de voz"}.</p>`;
      body.innerHTML = reading + style(s);
    });
  });
</script>

<style is:global>
  .affect-body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    align-items: start;
    gap: var(--s-4) var(--s-5);
  }

  .affect-body > .style,
  .affect-body > .affect-empty {
    grid-column: 1 / -1;
  }

  .affect-empty {
    color: var(--ink-3);
    font-size: var(--t-sm);
  }

  .reading {
    --tone: var(--ink-2);
    display: grid;
    gap: var(--s-2);
  }

  .reading.sent-positive { --tone: var(--green-ink); }
  .reading.sent-negative { --tone: var(--red-ink); }
  .reading.sent-uncertain { --tone: var(--ink-3); }

  .reading .about {
    color: var(--ink-3);
    font-size: var(--t-xs);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reading .emotion {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: var(--tone);
  }

  .reading .emotion::first-letter {
    text-transform: uppercase;
  }

  .reading .facts,
  .reading .split dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem var(--s-3);
    font-size: var(--t-sm);
  }

  .reading dt {
    color: var(--ink-3);
  }

  .reading dd {
    font-weight: 600;
  }

  .reading .split {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    padding: var(--s-3);
    border-radius: var(--r-md);
    background: var(--amber-soft);
  }

  .reading .cues {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .reading .cues li {
    padding: 0.1rem 0.55rem;
    border-radius: var(--r-pill);
    background: var(--subtle-2);
    color: var(--ink-2);
    font-size: var(--t-xs);
  }

  .valence {
    width: 100%;
    max-width: 420px;
    height: auto;
    overflow: visible;
  }

  .valence .grid line {
    stroke: var(--border);
    stroke-width: 1;
  }

  .valence .grid text {
    fill: var(--ink-3);
    font-size: 10.5px;
    font-family: var(--font-body);
  }

  .valence path {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .valence circle {
    stroke: var(--card);
    stroke-width: 2;
  }

  .valence .pos { fill: var(--green); }
  .valence .neu { fill: var(--ink-2); }
  .valence .neg { fill: var(--red); }

  .affect .style {
    display: grid;
    gap: var(--s-1);
    padding-top: var(--s-3);
    border-top: 1px dashed var(--border-strong);
  }

  .affect .style-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--ink-3);
    font-size: var(--t-sm);
  }

  .affect .style-name strong {
    font-family: var(--font-display);
    font-size: var(--t-md);
    color: var(--ink);
  }

  .affect .style-directo .style-name strong {
    color: var(--primary-ink);
  }

  .affect .why,
  .affect .signal {
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.4;
  }

  .affect .signal {
    color: var(--violet-ink);
  }
</style>
