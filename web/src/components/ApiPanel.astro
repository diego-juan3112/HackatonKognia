---
/**
 * «API en vivo» (F-11, A-24): every query with its SoQL, time, rows, source,
 * cutoff, cache badge (live / fresh / stale) and a «Reconsultar» button.
 */
---

<section class="card board-card api" id="api" data-testid="api-panel" data-section="api" aria-labelledby="api-title">
  <header class="board-head">
    <h2 id="api-title">Herramientas que usó <b class="count num" id="api-count" hidden></b></h2>
    <p id="api-origin"></p>
  </header>
  <details class="tool-catalog" id="tool-catalog" data-testid="tool-catalog">
    <summary>Qué sabe hacer el agente <b class="num" id="tool-catalog-count"></b></summary>
    <ul id="tool-catalog-list"></ul>
  </details>
  <div class="tool-turns" id="tool-turns" data-testid="tool-turns"></div>
  <ol class="api-list board-scroll" id="api-list" aria-live="polite" tabindex="0" aria-label="Consultas a datos.gov.co"></ol>
</section>

<script>
  import { bind, byId, dur, esc, panel, reconcile } from "../scripts/dom";
  import { evidenceBody, toolLabel } from "../scripts/evidence";
  import { USING_MOCKS } from "../voice/api";
  import * as controller from "../voice/controller";

  const RESULT: Record<string, string> = {
    ok: "respondió",
    empty: "sin registros",
    ambiguous: "pidió aclarar",
    unavailable: "la fuente no respondió",
    invalid: "la rehízo",
  };
  const ORIGIN: Record<string, string> = { live: "en vivo", fresh: "guardado hace menos de 1 min", stale: "respuesta anterior" };

  panel("api", (root) => {
    const list = byId("api-list");
    const origin = byId("api-origin");
    if (origin) {
      origin.textContent = USING_MOCKS ? "Sin backend: respuestas grabadas el 9-oct-2026." : "Cada dato que dice el agente sale de una consulta en vivo a datos.gov.co. La más reciente va primero.";
    }
    root.addEventListener("click", (e) => {
      const id = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-requery]")?.dataset.requery;
      if (id) void controller.requery(id);
    });
    const catalogCount = byId("tool-catalog-count");
    const catalogList = byId("tool-catalog-list");
    const turnsBox = byId("tool-turns");
    const unbindCatalog = bind(["tools", "meta"], (s) => {
      if (catalogCount) catalogCount.textContent = String(s.toolCatalog.length);
      if (catalogList) {
        catalogList.innerHTML = s.toolCatalog.length
          ? s.toolCatalog.map((t) => `<li><strong>${esc(toolLabel(t.name))}</strong> <span>${esc(t.description)}</span></li>`).join("")
          : "<li>El servidor todavía no envió la lista.</li>";
      }
      if (turnsBox) {
        // Per turn: which tools the agent used, with status, time, rows and cache.
        const byTurn = new Map<string, typeof s.tools>();
        for (const t of s.tools) {
          const k = t.turn_id ?? "—";
          byTurn.set(k, [...(byTurn.get(k) ?? []), t]);
        }
        const rows = [...byTurn.entries()].reverse().map(([turnId, tools]) => {
          const n = s.turns.find((x) => x.turn_id === turnId)?.n;
          return tools
            .map(
              (t, i) =>
                `<tr>${i === 0 ? `<th rowspan="${tools.length}">${n ? `Turno ${n}` : "—"}</th>` : ""}<td>${esc(toolLabel(t.name))}</td><td class="st-${esc(t.status ?? "pending")}">${esc(RESULT[t.status ?? ""] ?? "en curso")}</td><td>${t.trace ? dur(t.trace.ms) : "—"}</td><td>${t.trace ? esc(ORIGIN[t.trace.cache_status] ?? "—") : "—"}</td></tr>`,
            )
            .join("");
        });
        turnsBox.innerHTML = rows.length
          ? `<table><caption>Qué hizo en cada turno</caption><thead><tr><th>Turno</th><th>Qué hizo</th><th>Resultado</th><th>Tardó</th><th>Origen del dato</th></tr></thead><tbody>${rows.join("")}</tbody></table>`
          : "";
      }
    });
    const unbindList = bind(["tools"], (s) => {
      const count = byId("api-count");
      if (count) {
        count.hidden = s.tools.length === 0;
        count.textContent = String(s.tools.length);
      }
      if (!list) return;
      // Keyed update: «Reconsultar» repaints only its own entry and keeps keyboard focus.
      reconcile(
        list,
        s.tools.length
          ? [...s.tools].reverse().map((t) => ({
              key: t.tool_call_id,
              cls: `api-item${t.invalidated ? " invalidated" : ""}`,
              html: evidenceBody(t, s),
              testid: "evidence-card",
            }))
          : [{ key: "empty", cls: "board-empty", html: "Cuando el agente consulte la fuente, aquí verás qué buscó, qué encontró y cuánto tardó." }],
      );
    });
    return () => {
      unbindCatalog();
      unbindList();
    };
  });
</script>

<style is:global>
  .tool-catalog,
  .tool-turns {
    margin: 0 var(--s-4) var(--s-3);
    font-size: var(--t-xs);
  }

  .tool-catalog summary {
    cursor: pointer;
    font-weight: 650;
  }

  .tool-catalog ul {
    display: grid;
    gap: 2px;
    margin-top: var(--s-2);
  }

  .tool-turns table {
    width: 100%;
    border-collapse: collapse;
  }

  .tool-turns caption {
    text-align: left;
    font-weight: 650;
    padding-bottom: var(--s-1);
  }

  .tool-turns th,
  .tool-turns td {
    padding: 2px var(--s-1);
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .tool-turns .st-ok { color: var(--accent-ink); }
  .tool-turns .st-unavailable,
  .tool-turns .st-invalid { color: var(--danger); }

  .api .count {
    display: inline-block;
    min-width: 1.5rem;
    margin-left: var(--s-1);
    padding: 0 0.4rem;
    border-radius: var(--r-pill);
    background: var(--primary-soft);
    color: var(--primary-ink);
    font-family: var(--font-body);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.5rem;
    text-align: center;
    vertical-align: 0.15em;
  }

  .api-item .tool-name {
    font-size: var(--t-sm);
  }

  .api-item .tech summary {
    width: fit-content;
    color: var(--ink-3);
    font-size: var(--t-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .api-item .tech[open] summary {
    margin-bottom: var(--s-2);
  }

  .api-item {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4) 0;
    border-top: 1px solid var(--border);
    min-width: 0;
  }

  .api-item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .api-item .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-2);
  }

  .api-item .head code {
    color: var(--primary-ink);
    font-size: var(--t-sm);
    font-weight: 700;
  }

  .api-item .args {
    color: var(--ink-3);
    font-size: var(--t-xs);
  }

  .api-item .soql {
    margin: 0;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: var(--code-bg);
    color: var(--code-ink);
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .soql .kw { color: var(--code-kw); font-weight: 600; }
  .soql .fn { color: var(--code-fn); }
  .soql .str { color: var(--code-str); }

  .api-item .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    color: var(--ink-2);
    font-size: var(--t-sm);
  }

  .api-item .meta strong {
    color: var(--ink);
    font-weight: 700;
  }

  .api-item .fields {
    display: grid;
    gap: 2px var(--s-3);
    font-size: var(--t-sm);
  }

  .api-item .fields > div {
    display: grid;
    grid-template-columns: minmax(7rem, 30%) minmax(0, 1fr);
    gap: var(--s-2);
  }

  .api-item .fields dt {
    color: var(--ink-3);
  }

  .api-item .fields dd {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .api-item .records {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }

  .api-item .records > li {
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--border);
    border-radius: var(--r-md, 10px);
  }

  .api-item .value {
    color: var(--ink-2);
  }

  .api-item .value strong {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .api-item .groups {
    display: grid;
    gap: 0.3rem;
  }

  .api-item .groups li {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(2rem, 1fr) 4.2rem;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-sm);
  }

  .api-item .groups .k {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-2);
  }

  .api-item .groups .bar {
    height: 0.6rem;
    border-radius: 3px;
    background: var(--subtle-2);
  }

  .api-item .groups .bar i {
    display: block;
    height: 100%;
    min-width: 3px;
    border-radius: 3px;
    background: var(--blue-500);
  }

  .api-item .groups .v {
    text-align: right;
    font-weight: 700;
  }

  .api-item .unit,
  .api-item .src {
    color: var(--ink-3);
    font-size: var(--t-xs);
    line-height: 1.45;
  }

  .api-item .warnings {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
  }

  .api-item .warnings li {
    padding: 0.05rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    color: var(--ink-2);
    font-size: var(--t-xs);
    font-weight: 550;
  }

  .api-item .err {
    color: var(--danger);
    font-size: var(--t-sm);
  }

  .api-item .requery {
    font-size: var(--t-xs);
    color: var(--ink-2);
  }

  .api-item .requery.ok {
    color: var(--primary-ink);
    font-weight: 650;
  }

  .api-item .requery.bad {
    color: var(--danger);
    font-weight: 650;
  }

  .api-item .requery-btn {
    justify-self: start;
  }

  .api-item .requery-btn[aria-disabled="true"] {
    opacity: 0.5;
    cursor: progress;
  }

  .api-item .waiting {
    color: var(--accent-ink);
    font-size: var(--t-sm);
  }

  .api-item .void {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--accent-ink);
    font-size: var(--t-xs);
    font-weight: 650;
  }

  .api-item.invalidated > :not(.void) {
    opacity: 0.5;
  }

  .api-item.invalidated .value strong {
    text-decoration: line-through;
  }
</style>
