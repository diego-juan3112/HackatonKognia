---
/**
 * Explicit consent for voice analysis (R-26, A-25). Declining keeps the
 * text-only estimate; nothing is recorded either way.
 */
import AudioLines from "@lucide/astro/icons/audio-lines";
---

<dialog class="consent-dialog" id="consent-dialog" aria-labelledby="consent-title">
  <form method="dialog">
    <h2 id="consent-title"><AudioLines aria-hidden="true" /> ¿Analizar también tu tono de voz?</h2>
    <p>
      Si aceptas, de cada intervención tuya se envía un recorte de audio de hasta 30 segundos para estimar cómo suenas
      (por ejemplo, con prisa o con frustración) y ajustar el tono de las respuestas.
    </p>
    <ul>
      <li>El recorte se usa durante esa petición y se descarta. No se guarda audio.</li>
      <li>Es una estimación incierta, nunca un diagnóstico, y no cambia ningún dato.</li>
      <li>Puedes apagarlo cuando quieras. Sin permiso, solo se analiza el texto.</li>
    </ul>
    <div class="actions">
      <button class="btn" value="no">No, solo el texto</button>
      <button class="btn btn-primary" value="yes">Sí, analizar mi voz</button>
    </div>
  </form>
</dialog>

<script>
  import { byId, panel } from "../scripts/dom";
  import * as controller from "../voice/controller";

  panel("consent-dialog", (root) => {
    const dialog = root as HTMLDialogElement;
    dialog.addEventListener("close", () => {
      if (dialog.returnValue === "yes") controller.setVoiceAnalysis(true);
      dialog.returnValue = "";
      byId("voice-switch")?.focus();
    });
  });
</script>

<style>
  .consent-dialog {
    width: min(34rem, calc(100vw - 2rem));
    padding: var(--s-6);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-lg);
    background: var(--card);
    color: var(--ink);
  }

  .consent-dialog::backdrop {
    background: rgb(6 8 28 / 0.7);
    backdrop-filter: blur(3px);
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-lg);
  }

  p {
    margin-top: var(--s-4);
    color: var(--ink-2);
  }

  ul {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-4);
    color: var(--ink-2);
    font-size: var(--t-sm);
  }

  li {
    padding-left: var(--s-4);
    border-left: 2px solid var(--green);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .actions .btn:not(.btn-primary) {
    min-height: 3rem;
  }
</style>
